{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Data": "Data Source=App_Data/radar.db" // относительный путь - от папки веб-проекта
  },

  "JwtSettings": {
    "Issuer": "radar.forecast",
    "Audience": "radar.forecast.client",
    "Key": "4JTffXo2uXOBgDc-JaBIIOmDOes7BswuPhwDtQnAfubZBXNHcEsGGJBiiUWPUrwU",
    "AccessTokenMinutes": 30, // время жизни токена доступа
    "RefreshTokenHours": 48 // сколько живёт вход без повторного ввода пароля
  },

  // пароль учётной записи admin при первом запуске (если записи ещё нет)
  "Seed": {
    "AdminPassword": "123456"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5175" ]
  },

  // движок прогноза (engine/main.py)
  "Engine": {
    "Url": "http://127.0.0.1:8765",
    "TimeoutSeconds": 120 // прогон длинного лога целиком
  },

  // относительные пути - от папки веб-проекта
  "Storage": {
    "Root": "App_Data", // files/ - загруженные файлы, runs/ - результаты запусков, models/ - загруженные пакеты моделей
    "DiplomFlightLogs": "../../../diplom_project/flight_logs", // логи полётов диплома, только чтение
    "DiplomBundles": "../../../diplom_project/bundles" // пакеты моделей всех прогонов диплома (<прогон>/<случай>/...), только чтение: справочник моделей
  },

  // флаги активности фоновых служб (ключ - имя класса службы, нет ключа - включена); изменение - после перезапуска
  "BackgroundServices": {
    "RealtimeClock": true // таймер обзоров реального времени: проигрывание сессий (шаг и перемотка работают и без него)
  },

  // реальное время
  "Realtime": {
    "TickMilliseconds": 5, // шаг проверки таймера; таймер Windows точнее ~15 мс не дает
    "IdleMinutes": 60, // сессия на паузе без действий дольше - закрывается
    "CatchUpBatch": 200 // перемотка вперед: обзоров в одном запросе к движку
  },

  "Map": {
    "YandexMapsKey": "3a96ce19-f774-4d6c-b003-1b1456e02b90"
  },

  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/${shortdate}.log",
        "layout": "${longdate} | ${event-properties:item=EventId_Id:whenEmpty=0} | ${uppercase:${level}} | ${logger} | ${message} ${exception:format=tostring} | ${callsite}"
      },
      "logconsole": {
        "type": "ColoredConsole",
        "layout": "${longdate} | ${event-properties:item=EventId_Id:whenEmpty=0} | ${uppercase:${level}} | ${logger} | ${message} ${exception:format=tostring} | ${callsite}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.EntityFrameworkCore.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "System.Net.Http.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "radar.forecast.Helper.RequestTiming",
        "minLevel": "Info",
        "writeTo": "logfile",
        "final": true
      },
      {
        "logger": "radar.forecast.*",
        "minLevel": "Info",
        "writeTo": "logfile,logconsole",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Warn",
        "writeTo": "logfile,logconsole"
      }
    ]
  }
}
