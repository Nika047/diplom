<?xml version="1.0" encoding="utf-8"?>
<!-- серверу нужен только nuget.org: общий источник Telerik требует входа и без него ломает восстановление пакетов -->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
